# ============================================================================
# textin-service 环境模板
#   cp .env.example .env   ——  **全部留空也能起来**：上游匿名可用（token 传空串）
#
# 每个旋钮都必须有人读（本仓由 tests/test_wiring.py 的配置门禁守着）——
# 不登记"暂时用不到"的旋钮，免得它们变成假配置。
# ============================================================================

# ---------------------------------------------------------------- 上游（api.textin.com）
# 单一端点 + service 名切换全部能力（详见 docs/UPSTREAM.md）。
TEXTIN_BASE_URL=https://api.textin.com
TEXTIN_OCR_PATH=/home/user_trial_ocr

# 可选登录 token（浏览器 localStorage._textin_token）。留空 = 匿名，token 头传空串即可。
# ⚠️ 它是凭据：不要提交 .env、不要贴进 issue、不要在日志里回显。
# 未取证：配了 token 后配额口径如何变化（无账号，没测过）。
TEXTIN_TOKEN=

# 超时：图像/识别族一条 60s 够；文档转换族给 120s（word-to-image 实测 7s，留裕量）。
TEXTIN_TIMEOUT=60
TEXTIN_CONVERT_TIMEOUT=120

# 🔴 XFF 轮换：**默认 0 = 刻意不做**。
# 上游信任 X-Forwarded-For，换 IP 即重置匿名配额（实测）—— 但那是**对抗性规避**，
# 与本项目的立场冲突（只做服务端允许范围内的降速与退避）。研究结论见 docs/UPSTREAM.md。
# 置 1 只影响匿名调用（配了 token 时不发该头）。
TEXTIN_ROTATE_XFF=0

# 出口代理池（逗号分隔的 HTTP 代理 URL，如 http://user:pass@host:port,http://host2:port2）。
# **留空 = 直连**（默认）。配置后**每个上游请求新建连接**并轮换到下一个代理。
#
# 📌 依据（2026-09-24 归因实验，docs/UPSTREAM.md §4）：textin 的 `451` 是**按出口 IP
#    的软限** —— 同一 IP 换身份（真实 Chrome ↔ 裸客户端）行为同型；换新 IP（同身份）
#    立刻恢复。⇒ 要绕只能换出口，代理池是其中更"真"的一种（相对 XFF 伪造）。
# ⚠️ 两条实测注意：① 轮换靠"每请求新连接"，复用连接会拿回同一出口；
#    ② **出口 IP 的额度是共享的** —— 共享节点可能已被别人用掉一部分（实测某节点首发即 451）。
TEXTIN_PROXY_POOL=

# 外链输入的硬上限：调用方传 URL 时由本服务代取，超过即拒（也看 Content-Length 预判）。
TEXTIN_MAX_DOWNLOAD_MB=50

# ---------------------------------------------------------------- 本服务
# 逗号分隔的静态 Key 白名单。**留空 = 关闭鉴权**（仅限内网/联调，启动会 WARNING）。
# 生产必须设置：任何能访问本端口的人都能消耗你的配额。
TEXTIN_API_KEYS=
TEXTIN_PORT=8600
TEXTIN_LOG_LEVEL=INFO

# ---------------------------------------------------------------- 结果交付
# 响应默认 b64_json（结果直接进响应体）；调用方要 url 时本服务把结果落盘到
# MEDIA_DIR，以 /files/{name} 提供。**文件不设 TTL**，由部署方清理。
TEXTIN_MEDIA_DIR=var/media

# ---------------------------------------------------------------- 额度闸门
# code=431（**按天**总额度打满）后进入静默窗（秒）：窗内直接 429，不再白打上游。
# 431 当天不恢复，所以静默是纯收益。`451`（per-service 试用配额）**不进静默窗** ——
# 它的计数是多节点软限（实测第 4 次失败后第 5/6 次又能成功），偶发重试可能成功。
TEXTIN_QUOTA_COOLDOWN=1800

# ---------------------------------------------------------------- 未取证能力（默认全关）
# `text_auto_removal` / `ofd-to-image` 两项：service 名已见实测记录，但**返回体未端到端校验**
# （ofd 连样本都没有）。默认 0 ⇒ 调用回 503 + 开启方式；置 1 放开，风险由部署方判断。
TEXTIN_ALLOW_UNVERIFIED=0

# ---------------------------------------------------------------- 可观测性（可选，可静默降级）
# 未配 TOKEN ⇒ 只出本地日志；缺 logfire 包也只打一行 INFO，绝不阻塞业务。
TEXTIN_LOGFIRE_TOKEN=
TEXTIN_OTEL_SERVICE_NAME=textin-service
TEXTIN_LOGFIRE_ENVIRONMENT=
TEXTIN_OTEL_CAPTURE_UPSTREAM=1
TEXTIN_OTEL_SCRUBBING=0
